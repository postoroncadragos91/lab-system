# Căutare pacient — configurație opțională
#
# Lăsați DB_TABLE gol pentru baza locală SQLite, cu pacienți fictivi.
# Completați valorile de mai jos doar pentru serverul dumneavoastră.
# Nu scrieți date reale de pacienți în acest fișier.
# Nu publicați fișierul după ce ați pus parola.
# Fără spații în jurul semnului = și fără ghilimele.
#
# DB_DRIVER: mysql, postgres sau mssql

DB_DRIVER=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TABLE=

# Numele coloanelor din tabelul real.
COL_COD_PACIENT=
COL_NUME=
COL_PRENUME=
COL_DATA_NASTERII=
COL_IDNP=
COL_SEX=
COL_TELEFON=
COL_ADRESA=
